{
  "compilerOptions": {
    "target": "ES2023",
    // Every context this config covers is a browser one — a service worker, a content
    // script, an offscreen document and a popup — so `node` and `bun` are deliberately
    // absent from `types`. That is not tidiness: `Buffer` and `process` resolving here
    // would type-check code that throws the moment it runs, which is exactly the shape
    // of the `utf8Bytes` bug this tree had to fix by hand in the viewer.
    //
    // `scripts` and `tests` are node, and are checked separately by tsconfig.tools.json.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["chrome"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // Not `erasableSyntaxOnly`, for the same reason as apps/viewer: nothing here is
    // ever run as TypeScript with its types stripped. Every entry point is bundled.
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  // `src/shared/contract.ts` type-imports the client's wire types and
  // `src/shared/geometry.ts` re-exports the viewer's arithmetic, so a rename in
  // either fails here rather than in a popup nobody opened yet.
  "include": ["src"]
}
