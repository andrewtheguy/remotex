{
  // The half of this tree that runs on node rather than in a browser: the build and
  // pack scripts, and the tests, which use `node:test` throughout and `node:fs` in
  // `manifest.test.ts`.
  //
  // Split from tsconfig.json so that config can withhold `node` and `bun` from `src`,
  // where a `Buffer` that type-checks is a `Buffer` that throws at runtime. The two are
  // checked independently — `bun run check` runs both — so neither environment can
  // borrow the other's globals.
  //
  // `chrome` is here as well because the tests import the worker's modules, which are
  // written against it.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "bun", "chrome"]
  },
  "include": ["scripts", "tests"]
}
