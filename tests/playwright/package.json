{
  "name": "remotex-playwright-e2e",
  "private": true,
  "scripts": {
    "deps": "test -x node_modules/.bin/tsc || bun install --frozen-lockfile",
    "pretest": "bun run deps",
    "test": "playwright test",
    "pretest:clipboard": "bun run deps",
    "test:clipboard": "playwright test '/clipboard\\.spec\\.ts$'",
    "pretest:oversized": "bun run deps",
    "test:oversized": "playwright test '/oversized-clipboard\\.spec\\.ts$'",
    "pretest:tiles": "bun run deps",
    "test:tiles": "playwright test '/tiles\\.spec\\.ts$'",
    "pretest:hevc": "bun run deps",
    "test:hevc": "playwright test '/software-hevc-(chrome|firefox|faked)\\.spec\\.ts$'",
    "pretypecheck": "bun run deps",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "^26.1.1",
    "typescript": "~5.9"
  }
}
