# Minimal dummy VNC server for the e2e tests (tests/vnc_tiles_e2e.rs).
#
# Xtigervnc is an X server with a built-in RFB server: with no window manager
# or session it still serves a paintable root window, so a client's first
# non-incremental FramebufferUpdateRequest gets a real full-screen update
# through the whole pipeline. Classic VncAuth is enabled (password below) so
# the DES challenge path is exercised too. tigervnc-tools ships tigervncpasswd;
# xfonts-base is needed for the X server's builtin 'fixed' font at startup, and
# x11-xserver-utils for xsetroot.
#
# The root window is deliberately not left at its default flat colour. TigerVNC
# sends a solid rectangle as RRE with zero subrectangles whatever encoding the
# client preferred, because that is the cheapest way to say "all one colour" —
# so a blank desktop exercises RRE and never reaches the ZRLE encoder at all.
# A two-colour pattern makes the rectangles real, and ZRLE is then what a client
# advertising it actually receives.
FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        tigervnc-standalone-server tigervnc-tools xfonts-base x11-xserver-utils \
    && rm -rf /var/lib/apt/lists/*
# The e2e test authenticates with this password (VncAuth ignores bytes past 8).
RUN printf 'secret42\n' | tigervncpasswd -f > /etc/vncpasswd
# Start the server, then keep trying to paint until the display answers. xsetroot
# is the wait as well as the paint: it fails until the X server is listening.
RUN printf '%s\n' \
    '#!/bin/sh' \
    'Xtigervnc :1 -rfbport 5900 -interface 0.0.0.0 \' \
    '  -SecurityTypes VncAuth -PasswordFile /etc/vncpasswd \' \
    '  -geometry 1024x768 -depth 24 &' \
    'until xsetroot -display :1 -mod 16 16 -fg red -bg blue 2>/dev/null; do sleep 0.1; done' \
    'wait' \
    > /usr/local/bin/dummy-vnc && chmod +x /usr/local/bin/dummy-vnc
EXPOSE 5900
CMD ["/usr/local/bin/dummy-vnc"]
