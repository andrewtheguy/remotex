#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""Session controller for the sway virtual-display remote session.

Runs on the sway host beside a stock wayvnc, as the desktop user, inside the
compositor's environment. It listens to wayvnc's control events and, while at
least one VNC client is connected, replaces every physical output with one
resizable headless output that wayvnc captures. On the last disconnect, on a
local console switch, on `sway-remote-session end`, or on its own shutdown it
puts the desktop back from a snapshot written before anything was touched.
The design, the choreography and the policies are in
docs/sway-remote-session.md; this is stage 1 of its plan, so size, scale and
policy come from the command line rather than from the wire.

Standard library only.
"""

from __future__ import annotations

import argparse
import json
import logging
import os
import select
import signal
import socket
import struct
import subprocess
import sys
import time
from dataclasses import dataclass, field

log = logging.getLogger("sway-remote-session")

IPC_MAGIC = b"i3-ipc"
IPC_RUN_COMMAND = 0
IPC_GET_WORKSPACES = 1
IPC_GET_OUTPUTS = 3
IPC_GET_INPUTS = 100

POINTER_TYPES = {"pointer", "touchpad", "tablet_tool", "tablet_pad", "touch"}


class SwayError(Exception):
    pass


def recv_exact(sock: socket.socket, size: int) -> bytes:
    chunks = []
    while size:
        chunk = sock.recv(size)
        if not chunk:
            raise SwayError("sway IPC closed mid-reply")
        chunks.append(chunk)
        size -= len(chunk)
    return b"".join(chunks)


def sway_quote(value: str) -> str:
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


class SwayIpc:
    """One request per connection; sway accepts any number of them."""

    def __init__(self, path: str):
        self.path = path

    def _request(self, kind: int, payload: bytes = b""):
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.connect(self.path)
            sock.sendall(IPC_MAGIC + struct.pack("<II", len(payload), kind) + payload)
            header = recv_exact(sock, 14)
            if header[:6] != IPC_MAGIC:
                raise SwayError("bad IPC magic in reply")
            length, _ = struct.unpack("<II", header[6:])
            return json.loads(recv_exact(sock, length))

    def command(self, command: str) -> None:
        log.debug("swaymsg %s", command)
        results = self._request(IPC_RUN_COMMAND, command.encode())
        failed = [r for r in results if not r.get("success")]
        if failed:
            raise SwayError(f"{command!r}: {failed}")

    def try_command(self, command: str) -> bool:
        try:
            self.command(command)
            return True
        except (SwayError, OSError) as error:
            log.warning("restore step failed: %s", error)
            return False

    def outputs(self) -> list[dict]:
        return self._request(IPC_GET_OUTPUTS)

    def inputs(self) -> list[dict]:
        return self._request(IPC_GET_INPUTS)

    def workspaces(self) -> list[dict]:
        return self._request(IPC_GET_WORKSPACES)


def find_swaysock() -> str:
    path = os.environ.get("SWAYSOCK")
    if path and os.path.exists(path):
        return path
    runtime = runtime_dir()
    candidates = sorted(
        (p for p in os.listdir(runtime) if p.startswith("sway-ipc.") and p.endswith(".sock")),
        key=lambda p: os.stat(os.path.join(runtime, p)).st_mtime,
    )
    if not candidates:
        raise SystemExit(f"no sway IPC socket under {runtime}; set SWAYSOCK")
    return os.path.join(runtime, candidates[-1])


def runtime_dir() -> str:
    return os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"


def is_virtual_input(device: dict) -> bool:
    # Virtual devices carry vendor and product 0. wayvnc's keyboard and pointer
    # are the ones that must never be touched; they exist only while a client is
    # connected, which is exactly when the snapshot is taken.
    return device["identifier"].startswith("0:0:")


# ---------------------------------------------------------------- snapshot


def take_snapshot(ipc: SwayIpc, session_prefix: str, vt: int) -> dict:
    outputs = []
    for output in ipc.outputs():
        if output["name"].startswith(session_prefix):
            continue
        mode = output.get("current_mode") or {}
        outputs.append(
            {
                "name": output["name"],
                "active": bool(output["active"]),
                "mode": {"width": mode.get("width"), "height": mode.get("height"), "refresh": mode.get("refresh")},
                "scale": output.get("scale"),
                "x": output["rect"]["x"],
                "y": output["rect"]["y"],
                "transform": output.get("transform"),
                "focused": bool(output.get("focused")),
            }
        )
    inputs = []
    for device in ipc.inputs():
        if is_virtual_input(device):
            continue
        inputs.append(
            {
                "identifier": device["identifier"],
                "type": device["type"],
                "send_events": (device.get("libinput") or {}).get("send_events"),
            }
        )
    workspaces = [
        {"name": ws["name"], "output": ws["output"], "focused": bool(ws["focused"])} for ws in ipc.workspaces()
    ]
    return {
        "taken_at": time.time(),
        "vt": vt,
        "session_output": None,
        "outputs": outputs,
        "inputs": inputs,
        "workspaces": workspaces,
    }


def write_json(path: str, data: dict) -> None:
    tmp = path + ".tmp"
    with open(tmp, "w") as handle:
        json.dump(data, handle, indent=2)
    os.replace(tmp, path)


def mode_arg(mode: dict) -> str | None:
    if not mode.get("width") or not mode.get("height"):
        return None
    text = f"{mode['width']}x{mode['height']}"
    if mode.get("refresh"):
        text += f"@{mode['refresh'] / 1000:.3f}Hz"
    return text


def restore_from_snapshot(ipc: SwayIpc, snapshot: dict, wayvncctl: str) -> None:
    """Best effort and idempotent: every step logs and continues on failure."""
    present = {o["name"]: o for o in ipc.outputs()}
    # Panels first, so workspaces have somewhere to go. One command per
    # property: sway 1.10 quietly ignores `enable` combined with a mode and
    # scale on an already enabled output.
    for output in snapshot["outputs"]:
        name = output["name"]
        if name not in present:
            log.warning("output %s is gone; skipping it", name)
            continue
        if not output["active"]:
            ipc.try_command(f"output {name} disable")
            continue
        ipc.try_command(f"output {name} enable")
        mode = mode_arg(output["mode"])
        if mode:
            ipc.try_command(f"output {name} mode {mode}")
        if output.get("scale"):
            ipc.try_command(f"output {name} scale {output['scale']}")
        ipc.try_command(f"output {name} position {output['x']} {output['y']}")
        if output.get("transform"):
            ipc.try_command(f"output {name} transform {output['transform']}")
    active_now = {o["name"] for o in ipc.outputs() if o["active"]}
    existing = {ws["name"] for ws in ipc.workspaces()}
    ordered = sorted(snapshot["workspaces"], key=lambda ws: ws["focused"])
    for ws in ordered:
        if ws["name"] not in existing or ws["output"] not in active_now:
            continue
        ipc.try_command(f"workspace {sway_quote(ws['name'])}; move workspace to output {ws['output']}")
    for device in snapshot["inputs"]:
        identifier = sway_quote(device["identifier"])
        if device["type"] == "keyboard":
            ipc.try_command(f"input {identifier} xkb_file -")
        elif device["type"] in POINTER_TYPES and device.get("send_events"):
            ipc.try_command(f"input {identifier} events {device['send_events']}")
    capture = next((o["name"] for o in snapshot["outputs"] if o["active"] and o["name"] in active_now), None)
    if capture and run_wayvncctl(wayvncctl, ["output-set", capture]):
        wait_for_capture(wayvncctl, capture)
    session_output = snapshot.get("session_output")
    if session_output and session_output in present:
        ipc.try_command(f"output {session_output} unplug")


def verify_restore(ipc: SwayIpc, snapshot: dict) -> list[str]:
    problems = []
    present = {o["name"]: o for o in ipc.outputs()}
    for want in snapshot["outputs"]:
        have = present.get(want["name"])
        if have is None:
            continue
        if bool(have["active"]) != want["active"]:
            problems.append(f"{want['name']} active={have['active']} wanted {want['active']}")
            continue
        if not want["active"]:
            continue
        mode = have.get("current_mode") or {}
        if (mode.get("width"), mode.get("height")) != (want["mode"]["width"], want["mode"]["height"]):
            problems.append(f"{want['name']} mode {mode.get('width')}x{mode.get('height')} wanted {mode_arg(want['mode'])}")
        if have.get("scale") != want["scale"]:
            problems.append(f"{want['name']} scale {have.get('scale')} wanted {want['scale']}")
        if (have["rect"]["x"], have["rect"]["y"]) != (want["x"], want["y"]):
            problems.append(f"{want['name']} position {have['rect']['x']},{have['rect']['y']} wanted {want['x']},{want['y']}")
    return problems


# ----------------------------------------------------------------- wayvnc


def run_wayvncctl(wayvncctl: str, args: list[str]) -> bool:
    try:
        result = subprocess.run([wayvncctl, *args], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired) as error:
        log.warning("wayvncctl %s: %s", " ".join(args), error)
        return False
    if result.returncode != 0:
        log.warning("wayvncctl %s failed: %s", " ".join(args), (result.stderr or result.stdout).strip())
        return False
    return True


def wait_for_capture(wayvncctl: str, output: str, timeout: float = 3.0) -> bool:
    """`output-set` returns before wayvnc has switched. Disabling or unplugging
    the output it still captures in that window has crashed wayvnc 0.9.1, so
    the choreography waits for the switch to show in `output-list`."""
    deadline = time.monotonic() + timeout
    while True:
        try:
            result = subprocess.run([wayvncctl, "-j", "output-list"], capture_output=True, text=True, timeout=5)
            outputs = json.loads(result.stdout or "[]") if result.returncode == 0 else []
        except (OSError, subprocess.TimeoutExpired, ValueError):
            outputs = []
        if any(o.get("name") == output and o.get("captured") for o in outputs):
            return True
        if time.monotonic() >= deadline:
            log.warning("wayvnc did not switch its capture to %s within %.1fs", output, timeout)
            return False
        time.sleep(0.1)


def wayvnc_clients(wayvncctl: str) -> list[dict]:
    try:
        result = subprocess.run([wayvncctl, "-j", "client-list"], capture_output=True, text=True, timeout=10)
        if result.returncode != 0:
            return []
        return json.loads(result.stdout or "[]")
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return []


# ------------------------------------------------------------------ keymap


def escape_keymap(escape_key: str, escape_vt: int) -> str:
    """A full XKB map: modifiers and F-keys only, Ctrl+Alt+Fn switching VT."""
    fkeys = "\n".join(
        f"    key <FK{n:02d}> {{ type = \"CTRL+ALT\", [ NoSymbol, NoSymbol, NoSymbol, NoSymbol, XF86Switch_VT_{n} ] }};"
        for n in range(1, 13)
    )
    esc = f"    key <ESC> {{ [ XF86Switch_VT_{escape_vt} ] }};\n" if escape_key == "esc" else ""
    return f"""xkb_keymap {{
  xkb_keycodes {{ include "evdev+aliases(qwerty)" }};
  xkb_types    {{ include "complete" }};
  xkb_compat   {{ include "complete" }};
  xkb_symbols  {{
    name[Group1] = "remote session";
    key <LCTL> {{ [ Control_L ] }};  key <RCTL> {{ [ Control_R ] }};
    key <LALT> {{ [ Alt_L, Meta_L ] }}; key <RALT> {{ [ Alt_R, Meta_R ] }};
    key <LWIN> {{ [ Super_L ] }}; key <RWIN> {{ [ Super_R ] }};
    key <LFSH> {{ [ Shift_L ] }}; key <RTSH> {{ [ Shift_R ] }};
    modifier_map Control {{ <LCTL>, <RCTL> }};
    modifier_map Mod1 {{ <LALT>, <RALT> }};
    modifier_map Mod4 {{ <LWIN>, <RWIN> }};
    modifier_map Shift {{ <LFSH>, <RTSH> }};
{fkeys}
{esc}  }};
}};
"""


# ------------------------------------------------------------------ daemon


@dataclass
class Config:
    swaysock: str
    wayvncctl: str
    state_dir: str
    vt_active_file: str
    vt: int
    session_prefix: str
    width: int
    height: int
    scale: float
    takeover: str
    escape_key: str
    escape_vt: int
    lock_command: str | None

    @property
    def snapshot_path(self) -> str:
        return os.path.join(self.state_dir, "snapshot.json")

    @property
    def active_marker(self) -> str:
        return os.path.join(self.state_dir, "active")

    @property
    def control_path(self) -> str:
        return os.path.join(self.state_dir, "control.sock")

    @property
    def keymap_path(self) -> str:
        return os.path.join(self.state_dir, "escape.xkb")


def read_active_vt(path: str) -> int | None:
    try:
        with open(path) as handle:
            text = handle.read().strip()
    except OSError:
        return None
    digits = "".join(ch for ch in text if ch.isdigit())
    return int(digits) if digits else None


@dataclass
class Daemon:
    cfg: Config
    ipc: SwayIpc
    state: str = "idle"  # idle | active
    snapshot: dict | None = None
    clients: dict[int, dict] = field(default_factory=dict)
    reverify_on_vt: int | None = None
    last_end_reason: str | None = None
    stop_requested: bool = False
    event_proc: subprocess.Popen | None = None
    event_buffer: bytes = b""

    # -- lifecycle -------------------------------------------------------

    def start_session(self) -> None:
        cfg = self.cfg
        log.info("starting the session: %dx%d at %sx on a new %s output", cfg.width, cfg.height, cfg.scale, cfg.session_prefix)
        snapshot = take_snapshot(self.ipc, cfg.session_prefix, cfg.vt)
        write_json(cfg.snapshot_path, snapshot)
        self.snapshot = snapshot
        try:
            before = {o["name"] for o in self.ipc.outputs()}
            self.ipc.command("create_output")
            created = [
                o["name"] for o in self.ipc.outputs() if o["name"] not in before and o["name"].startswith(cfg.session_prefix)
            ]
            if not created:
                raise SwayError("create_output made no output with the session prefix")
            session_output = created[0]
            snapshot["session_output"] = session_output
            write_json(cfg.snapshot_path, snapshot)
            self.ipc.command(f"output {session_output} scale {cfg.scale:g}")
            self.ipc.command(f"output {session_output} mode --custom {cfg.width}x{cfg.height}@60Hz")
            for ws in sorted(snapshot["workspaces"], key=lambda w: w["focused"]):
                self.ipc.command(f"workspace {sway_quote(ws['name'])}; move workspace to output {session_output}")
            self.ipc.command(f"focus output {session_output}")
            with open(cfg.keymap_path, "w") as handle:
                handle.write(escape_keymap(cfg.escape_key, cfg.escape_vt))
            for device in snapshot["inputs"]:
                identifier = sway_quote(device["identifier"])
                if device["type"] == "keyboard":
                    self.ipc.command(f"input {identifier} xkb_file {sway_quote(cfg.keymap_path)}")
                elif device["type"] in POINTER_TYPES:
                    self.ipc.command(f"input {identifier} events disabled")
            if run_wayvncctl(cfg.wayvncctl, ["output-set", session_output]):
                wait_for_capture(cfg.wayvncctl, session_output)
            for output in snapshot["outputs"]:
                if output["active"]:
                    self.ipc.command(f"output {output['name']} disable")
            self.ipc.command(f"output {session_output} position 0 0")
            with open(cfg.active_marker, "w") as handle:
                handle.write(session_output + "\n")
        except (SwayError, OSError) as error:
            log.error("session start failed, restoring: %s", error)
            self.end_session("compositor-refused")
            return
        self.state = "active"
        log.info("session active on %s", session_output)

    def end_session(self, reason: str) -> None:
        cfg = self.cfg
        log.info("ending the session: %s", reason)
        self.last_end_reason = reason
        for client_id in list(self.clients):
            run_wayvncctl(cfg.wayvncctl, ["client-disconnect", str(client_id)])
        snapshot = self.snapshot or self.load_snapshot()
        self.state = "idle"
        if snapshot is None:
            return
        restore_from_snapshot(self.ipc, snapshot, cfg.wayvncctl)
        try:
            os.unlink(cfg.active_marker)
        except FileNotFoundError:
            pass
        if reason == "local-takeover" and cfg.lock_command:
            subprocess.Popen(cfg.lock_command, shell=True)
        vt_now = read_active_vt(cfg.vt_active_file)
        if vt_now is not None and vt_now != snapshot["vt"]:
            # The compositor may not hold the VT; wlroots may have dropped the
            # commits. Re-run the restore when the VT comes back.
            log.info("VT %s is active, not the compositor's %s; restore is re-run on return", vt_now, snapshot["vt"])
            self.reverify_on_vt = snapshot["vt"]
            return
        self.finish_restore(snapshot)

    def finish_restore(self, snapshot: dict) -> None:
        problems = verify_restore(self.ipc, snapshot)
        if problems:
            for problem in problems:
                log.warning("after restore: %s", problem)
        else:
            log.info("desktop restored as snapshotted")
        try:
            os.unlink(self.cfg.snapshot_path)
        except FileNotFoundError:
            pass
        self.snapshot = None
        self.reverify_on_vt = None

    def load_snapshot(self) -> dict | None:
        try:
            with open(self.cfg.snapshot_path) as handle:
                return json.load(handle)
        except FileNotFoundError:
            return None
        except (OSError, ValueError) as error:
            log.error("unreadable snapshot %s: %s", self.cfg.snapshot_path, error)
            return None

    def recover(self) -> None:
        snapshot = self.load_snapshot()
        if snapshot is None:
            return
        log.warning("a snapshot from a previous run exists; restoring before listening")
        self.snapshot = snapshot
        self.end_session("daemon-restarted")

    # -- events ---------------------------------------------------------

    def on_wayvnc_event(self, event: dict) -> None:
        method = event.get("method")
        params = event.get("params") or {}
        log.debug("wayvnc event %s %s", method, params)
        if method == "wayvnc-startup":
            self.clients = {c["id"]: c for c in wayvnc_clients(self.cfg.wayvncctl) if "id" in c}
            if self.clients and self.state == "idle":
                self.start_session()
        elif method == "client-connected":
            self.clients[params.get("id")] = params
            log.info("client %s connected from %s as %s (%s connected)", params.get("id"), params.get("address"), params.get("username"), params.get("connection_count"))
            if self.state == "idle":
                self.start_session()
        elif method == "client-disconnected":
            self.clients.pop(params.get("id"), None)
            log.info("client %s disconnected (%s left)", params.get("id"), params.get("connection_count"))
            if self.state == "active" and not params.get("connection_count"):
                self.end_session("client-closed")
        elif method == "wayvnc-shutdown":
            self.clients.clear()
            if self.state == "active":
                self.end_session("wayvnc-exited")
        elif method == "output-removed":
            session_output = (self.snapshot or {}).get("session_output")
            if self.state == "active" and params.get("name") == session_output:
                self.end_session("compositor-removed-output")

    def on_vt_tick(self) -> None:
        vt = read_active_vt(self.cfg.vt_active_file)
        if vt is None:
            return
        if self.state == "active" and self.cfg.takeover == "vt" and vt != self.cfg.vt:
            log.info("console switched to VT %s: local takeover", vt)
            self.end_session("local-takeover")
        elif self.reverify_on_vt is not None and vt == self.reverify_on_vt and self.snapshot is not None:
            log.info("compositor's VT %s is back; re-running the restore", vt)
            restore_from_snapshot(self.ipc, self.snapshot, self.cfg.wayvncctl)
            self.finish_restore(self.snapshot)

    def on_control(self, conn: socket.socket) -> None:
        with conn:
            conn.settimeout(2)
            try:
                line = conn.makefile("rb").readline().decode().strip()
            except (OSError, UnicodeDecodeError):
                return
            reply: dict
            if line == "status":
                reply = self.status()
            elif line == "end":
                if self.state == "active":
                    self.end_session("ended-locally")
                    reply = {"ok": True, "state": self.state}
                else:
                    reply = {"ok": True, "state": self.state, "note": "no session was active"}
            elif line == "restore":
                snapshot = self.load_snapshot()
                if snapshot is None:
                    reply = {"ok": True, "note": "nothing to restore"}
                else:
                    self.snapshot = snapshot
                    self.end_session("restore-requested")
                    reply = {"ok": True, "state": self.state}
            else:
                reply = {"ok": False, "error": f"unknown command {line!r}"}
            try:
                conn.sendall((json.dumps(reply) + "\n").encode())
            except OSError:
                pass

    def status(self) -> dict:
        return {
            "state": self.state,
            "session_output": (self.snapshot or {}).get("session_output"),
            "clients": len(self.clients),
            "vt": read_active_vt(self.cfg.vt_active_file),
            "compositor_vt": self.cfg.vt,
            "takeover": self.cfg.takeover,
            "last_end_reason": self.last_end_reason,
            "pending_reverify": self.reverify_on_vt is not None,
        }

    # -- main loop ------------------------------------------------------

    def spawn_events(self) -> subprocess.Popen:
        proc = subprocess.Popen(
            [self.cfg.wayvncctl, "-j", "-w", "-r", "event-receive"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
        self.event_buffer = b""
        return proc

    def run(self) -> int:
        cfg = self.cfg
        os.makedirs(cfg.state_dir, mode=0o700, exist_ok=True)
        self.recover()

        control = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            os.unlink(cfg.control_path)
        except FileNotFoundError:
            pass
        control.bind(cfg.control_path)
        control.listen(4)
        control.setblocking(False)

        wake_r, wake_w = os.pipe()
        os.set_blocking(wake_w, False)
        signal.set_wakeup_fd(wake_w)
        for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            signal.signal(signum, lambda *_: setattr(self, "stop_requested", True))

        self.event_proc = self.spawn_events()
        poller = select.poll()
        poller.register(control.fileno(), select.POLLIN)
        poller.register(wake_r, select.POLLIN)
        poller.register(self.event_proc.stdout.fileno(), select.POLLIN | select.POLLHUP)
        log.info("listening; compositor on VT %s, policy %s, state %s", cfg.vt, cfg.takeover, self.state)

        while not self.stop_requested:
            events = poller.poll(500)
            for fd, flags in events:
                if fd == control.fileno():
                    try:
                        conn, _ = control.accept()
                    except OSError:
                        continue
                    self.on_control(conn)
                elif fd == wake_r:
                    os.read(wake_r, 64)
                elif fd == self.event_proc.stdout.fileno():
                    chunk = os.read(fd, 65536)
                    if not chunk:
                        poller.unregister(fd)
                        self.event_proc.wait()
                        log.warning("wayvncctl event stream ended (exit %s); reconnecting", self.event_proc.returncode)
                        if self.state == "active":
                            self.end_session("wayvnc-exited")
                        time.sleep(1)
                        self.event_proc = self.spawn_events()
                        poller.register(self.event_proc.stdout.fileno(), select.POLLIN | select.POLLHUP)
                        continue
                    self.event_buffer += chunk
                    while b"\n" in self.event_buffer:
                        line, self.event_buffer = self.event_buffer.split(b"\n", 1)
                        if not line.strip():
                            continue
                        try:
                            self.on_wayvnc_event(json.loads(line))
                        except ValueError:
                            log.warning("unparseable wayvnc event: %r", line[:200])
            self.on_vt_tick()

        log.info("shutting down")
        if self.state == "active":
            self.end_session("daemon-shutdown")
        if self.event_proc.poll() is None:
            self.event_proc.terminate()
        try:
            os.unlink(cfg.control_path)
        except FileNotFoundError:
            pass
        return 0


# --------------------------------------------------------------------- CLI


def control_request(cfg: Config, line: str) -> dict | None:
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(30)
            sock.connect(cfg.control_path)
            sock.sendall((line + "\n").encode())
            return json.loads(sock.makefile("rb").readline().decode())
    except (OSError, ValueError):
        return None


def parse_size(text: str) -> tuple[int, int]:
    try:
        width, height = (int(part) for part in text.lower().split("x"))
    except ValueError:
        raise argparse.ArgumentTypeError("expected WIDTHxHEIGHT") from None
    if width <= 0 or height <= 0:
        raise argparse.ArgumentTypeError("size must be positive")
    return width, height


def build_config(args: argparse.Namespace) -> Config:
    state_dir = args.state_dir or os.path.join(runtime_dir(), "sway-remote-session")
    vt = args.vt if args.vt is not None else read_active_vt(args.vt_active_file)
    if vt is None:
        raise SystemExit("cannot determine the compositor's VT; pass --vt")
    width, height = args.size
    return Config(
        swaysock=args.swaysock or find_swaysock(),
        wayvncctl=args.wayvncctl,
        state_dir=state_dir,
        vt_active_file=args.vt_active_file,
        vt=vt,
        session_prefix=args.session_output,
        width=width,
        height=height,
        scale=args.scale,
        takeover=args.takeover,
        escape_key=args.escape_key,
        escape_vt=args.escape_vt,
        lock_command=args.lock_command,
    )


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("command", nargs="?", choices=["daemon", "status", "end", "restore"], default="daemon")
    parser.add_argument("--swaysock", help="sway IPC socket (default: $SWAYSOCK, else the newest under the runtime dir)")
    parser.add_argument("--wayvncctl", default="wayvncctl")
    parser.add_argument("--state-dir", help="snapshot, keymap and control socket (default: $XDG_RUNTIME_DIR/sway-remote-session)")
    parser.add_argument("--vt-active-file", default="/sys/class/tty/tty0/active", help="file naming the active console")
    parser.add_argument("--vt", type=int, help="the compositor's VT (default: the active one at start)")
    parser.add_argument("--session-output", default="HEADLESS", help="name prefix of the created output")
    parser.add_argument("--size", type=parse_size, default=(1920, 1080), help="initial pixel mode WIDTHxHEIGHT; the client resizes it")
    parser.add_argument("--scale", type=float, default=1.0, help="output scale, 1 or 2")
    parser.add_argument("--takeover", choices=["vt", "login"], default="vt", help="vt: a console switch ends the session; login: only `end` does")
    parser.add_argument("--escape-key", choices=["esc", "none"], default="esc", help="also put the console switch on a bare Esc")
    parser.add_argument("--escape-vt", type=int, default=3, help="console the Esc key switches to")
    parser.add_argument("--lock-command", help="shell command run after a local takeover, e.g. a screen locker")
    parser.add_argument("-v", "--verbose", action="store_true")
    args = parser.parse_args(argv)

    logging.basicConfig(level=logging.DEBUG if args.verbose else logging.INFO, format="%(levelname)s %(message)s", stream=sys.stderr)
    cfg = build_config(args)

    if args.command == "daemon":
        return Daemon(cfg, SwayIpc(cfg.swaysock)).run()
    if args.command == "status":
        reply = control_request(cfg, "status")
        if reply is None:
            print(json.dumps({"state": "no-daemon", "snapshot": os.path.exists(cfg.snapshot_path)}))
            return 1
        print(json.dumps(reply))
        return 0
    if args.command == "end":
        reply = control_request(cfg, "end")
        if reply is None:
            raise SystemExit("the daemon is not running")
        print(json.dumps(reply))
        return 0
    if args.command == "restore":
        reply = control_request(cfg, "restore")
        if reply is not None:
            print(json.dumps(reply))
            return 0
        ipc = SwayIpc(cfg.swaysock)
        try:
            with open(cfg.snapshot_path) as handle:
                snapshot = json.load(handle)
        except FileNotFoundError:
            print("nothing to restore")
            return 0
        restore_from_snapshot(ipc, snapshot, cfg.wayvncctl)
        problems = verify_restore(ipc, snapshot)
        for problem in problems:
            log.warning("after restore: %s", problem)
        if not problems:
            os.unlink(cfg.snapshot_path)
        return 1 if problems else 0
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
