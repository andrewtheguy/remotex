# remotex configuration example
#
# The binary loads this file on startup (see src/config.rs). The config is
# global-only: --config <path> if given, else the installed
# <prefix>/etc/remotex.toml — no per-user or working-directory files. There are
# no environment variables — everything is configured here. Keep this file
# readable only by the service user — it holds credentials.
#
#   chmod 600 remotex.toml

[server]
# Listen address/port for the web UI (both optional; defaults shown).
#host = "127.0.0.1"
#port = 52380
# Directory of the built frontend. Defaults to share/remotex/web in the active
# version (or frontend/dist in a checkout). Only set to override.
#static_dir = ""
# Web login (required): username:bcrypt_hash guarding the whole surface.
# Generate with:  remotex gen-passwd <username>
site_passwd = ""
# Display name shown on the login screen, the interstitials, and as the browser
# tab title. Defaults to "remotex".
#branding = "remotex"

# DEVELOPMENT ONLY, and inert in any deployment. Gives this gateway its own
# hostname on loopback: a browser opening the home page under *any* loopback name
# that is not this one — 127.0.0.1, ::1, anything in 127/8, localhost, or another
# gateway's <other>.localhost — is redirected to http://<label>.localhost:<port>/,
# keeping the port. The port decides which gateway answers, and that gateway names
# itself, so http://127.0.0.1:52676/ lands on the label configured *here*.
#
# Redirecting a mismatched .localhost name matters as much as redirecting a bare
# address: reaching this gateway at another one's hostname would put this session's
# cookie under that name, which is the collision below, arrived at by editing the
# port in the URL bar and not the label.
#
# Only the home page is redirected, and only when the request itself arrived on a
# loopback name — a gateway reached under a real hostname or address ignores this
# however it is set.
#
# It solves one problem: a cookie is scoped by host and ignores the port, so two
# gateways on one machine share one session cookie and each login silently evicts
# the other. Every label under .localhost resolves to loopback without DNS
# (RFC 6761) and is a distinct cookie origin, so two gateways become two
# independent logins in one browser. Running two is the only way to test rxa
# session takeover, which is why this exists at all.
#
# One DNS label: letters, digits and inner hyphens, no dots.
#dev_subdomain = "gw-a"

# This gateway's identity on the "rxa" protocol — the macOS agent (see the rxa
# target near the end of this file). Required as soon as any target is
# protocol = "rxa", and unused otherwise.
#
# One key for the whole server, not one per Mac: this is the [Interface] half of
# a WireGuard-style pairing, and every agent carries its public half on the list
# of gateways it will answer.
# Generate with:      remotex gen-key
# Read the public half with:   remotex rxa-pubkey
#[rxa]
#private_key = "rxgs..."

# Target profiles (at least one required). Each needs a unique name. Every
# profile is served; the browser picks one from a picker after login (there is
# no --target selector).
[[targets]]
name = "example"
protocol = "rdp"           # required: "rdp", "vnc" or "rxa"
# Which flavour of that protocol the far end is, where a protocol has more than
# one. Only "vnc" has any: subtype = "ard" is macOS Screen Sharing (see below).
#subtype = "ard"
host = "192.0.2.10"
# Default: the protocol's standard port (3389 rdp, 5900 vnc, 52381 rxa).
#port = 3389

# Credentials (used server-side only; never sent to the browser).
username = "Administrator"
password = "change-me"
# A VNC server's own password (RFB VncAuth) — a separate key because it is a
# separate credential: it proves knowledge of a machine secret and names nobody.
# VNC only, rejected elsewhere. See the VNC target below.
#vnc_password = "change-me"
# Optional domain (leave unset for a local account). RDP only.
#domain = ""

# Initial desktop size to request.
#
# RDP connects at this size. A VNC server keeps its own instead and consults these
# only to answer a client that has no desktop-shaped window of its own — a phone
# asking for whatever this end considers right — which needs `resize = true` below
# before anything can be applied. rxa ignores them entirely: the size of a display
# the agent made is stated in the agent's own config, not here.
#
# On an RDP target with `resize` these are *points*, not pixels: the connect
# happens at 1x and a Retina client then asks for twice the pixels.
#width = 1280
#height = 800

# Security mode: "auto" (TLS+NLA, default), "nla" (NLA only), "tls" (no NLA).
# RDP only — VNC negotiates VncAuth (password set) or None per the handshake.
#security = "auto"

# Dynamic resize (opt-in): let a client drive the remote desktop size from its
# window. This is permission and nothing more — *how* the size is driven is the
# client's own choice, offered the same way on every protocol: once, on request
# ("Resize to window", and the default), or continuously ("Auto resize"), with the
# choice made per session and never remembered.
#
# Two narrowings that are not the client's to make. On VNC it works only on servers
# that accept SetDesktopSize — the TigerVNC family. On rxa it reaches only a
# display the agent made: see the rxa section below.
#
# Without it — and by default — the desktop keeps its connect-time size, no client
# offers either control, and the ones that ask anyway are ignored.
#resize = false

# Clipboard bridge (opt-in): shares this target's clipboard with the browser.
# Copying on the remote pushes the text out, and your local clipboard is sent
# back whenever the tab regains focus — where the browser permits it, which
# needs HTTPS or localhost, since a plain-HTTP page has no clipboard access at
# all. (The macOS viewer has no such restriction: it reads NSPasteboard
# directly.) The Clipboard panel always works regardless, and is the way to move
# text when automatic sync cannot run.
# Every protocol supports it. RDP (MS-RDPECLIP) and the Mac agent ("rxa")
# always carry full UTF-8. VNC does too on servers implementing the Extended
# Clipboard extension (TigerVNC does); on servers that do not (TightVNC), RFB
# falls back to latin-1 and anything outside it becomes "?".
#clipboard = false

# Remote audio (opt-in): redirect this target's sound to the browser, where the
# floating menu's Audio button plays it. RDP only — MS-RDPEA is the one audio
# channel the gateway speaks, so this is refused on "vnc" and "rxa" rather than
# accepted and left doing nothing.
#
# The channel has to be negotiated when the connection is made, so an audio
# target asks the server to redirect from the moment it connects and throws the
# sound away while nobody is listening. Only 44100 Hz 16-bit stereo PCM is
# accepted; a server that offers no matching format sends nothing, and the log
# says so.
#
# Two things worth knowing before switching this on. The browser decodes the Opus
# the gateway sends with WebCodecs, which is **secure-context only** — so a gateway
# reached over plain HTTP on a LAN address has no audio until it is behind TLS
# (localhost is exempt). And the macOS viewer has no audio at all: audio is sent
# only to a client that asks for it, and the viewer never does.
#audio = false

# A VNC target needs host and, usually, one of the two passwords; domain and
# security are ignored, and width/height only ever answer a default-size request
# (see above). `vnc_password` is the server's own password and is all a server
# without user accounts takes.
# [[targets]]
# name = "workstation-vnc"
# protocol = "vnc"
# host = "10.0.0.2"
# vnc_password = "change-me"

# A Mac can use its built-in Screen Sharing service through this same path,
# without installing the companion agent — say so with subtype = "ard", and give
# it an *account* rather than the Screen Sharing password. Apple's DH
# authentication is the only way to tell a Mac who is connecting, and macOS
# answers a viewer that names nobody by creating a new login window on a virtual
# display instead of sharing its screen. So the subtype requires username and
# password (that account's), takes no vnc_password, and rejects resize, which
# macOS accepts and then ignores. A third-party VNC server that happens to run
# on a Mac is not this: it is a plain "vnc" target.
# [[targets]]
# name = "mac-screen-sharing"
# protocol = "vnc"
# subtype = "ard"
# host = "10.0.0.3"
# username = "andrew"
# password = "the-account-password"

# As an optional alternative, a Mac can run the remotex agent (protocol "rxa")
# for RealVNC-like reconnect behavior. Reconnects authenticate from a keypair on
# each end instead of returning to Screen Sharing's login gate.
#
# Pairing is two public keys, one each way — the way WireGuard pairs an interface
# with a peer. Neither is a secret; the private key behind each stays on the
# machine that made it:
#
#   1. This gateway's identity is [rxa].private_key, above. Its public half —
#      printed by `remotex rxa-pubkey` — goes on the Mac's list of gateways it
#      will answer: one `<rxgp key> <name>` per line in
#      ~/Library/Application Support/remotex-agent/authorized_gateways, or via
#      Authorized gateways > Manage... in the agent's Settings dialog.
#   2. The Mac's public key goes in `agent_public_key` below. Its Settings dialog
#      shows it with a Copy button, and `remotex-agent --public-key` prints it.
#
# One [rxa].private_key serves every rxa target: it is this server's identity,
# not a per-Mac credential. And the Mac's side is a list, the way
# ~/.ssh/authorized_keys is, so a Mac can be reachable from a second gateway by
# adding a line there — no new key material, and the first gateway's config stays
# valid. Several gateways may be authorized; one holds the Mac at a time, and a
# second is refused until its client takes the session over.
#
# The agent runs in the Mac user's login session and needs two one-time grants
# in System Settings -> Privacy & Security: Screen Recording and Accessibility.
# It cannot run at the login window, so nobody logged in means nothing to reach.
#
# username/password/domain/width/height/security are all ignored here.
# `clipboard` is supported: the agent reads and writes the Mac's pasteboard.
#
# `resize` is supported, for one display only. A Mac's own screens are set on the
# Mac, in System Settings, and nothing here asks a physical panel to change; the
# agent notices whatever mode it is put in and the client follows. But the agent
# can also create a private display for itself (`virtual_display` in its own
# config), and nobody is sitting at that one — so with `resize = true` here, a
# client may resize it, on request or continuously, like any other target it is
# allowed to resize.
#
# What is narrower is *which display*, and that moves during a session: the
# permission applies only while the agent's own display is the one being shared.
# The viewer keeps its three View-menu items and greys them out otherwise; the
# browser shows its Resize section only while they apply. On a Mac whose agent has
# no such display it never applies at all.
# [[targets]]
# name = "mac"
# protocol = "rxa"
# host = "mac.local"
# agent_public_key = "rxap..."
