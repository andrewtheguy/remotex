# remotex configuration example
#
# The binary loads this file on startup (see src/config.rs). The config is
# global-only: --config <path> if given, else the installed
# <prefix>/etc/remotex.toml — no per-user or working-directory files. The listen
# address below is the one setting that can also come from outside this file
# (--listen, or REMOTEX_LISTEN); everything else, credentials included, is
# configured here. Keep this file readable only by the service user — it holds
# credentials.
#
#   chmod 600 remotex.toml
#
# This is the served gateway's file. remotex.app keeps its own in its instance
# directory and is the thing that edits it; everything below applies to both
# except [server], which that one has no use for and refuses.

# Display name of this gateway: the login screen, the interstitials, and the
# browser tab title. Defaults to "remotex". Top-level rather than under [server]:
# it names the deployment rather than the server, and one value with two spellings
# is one of them going stale.
#
# It is also the one setting this file shares with remotex.app's own config, which
# has no [server] block at all. The app supplies its gateway's ephemeral loopback
# listener, authentication token and bundled web root; its window loads that same
# web root as remotex://app. Edit that config from the app, not here.
#branding = "remotex"

[server]
# Listen address for the web UI, host:port (optional; default shown). One key,
# because it is one decision — a host without a port is half an answer.
#
# --listen (or REMOTEX_LISTEN in the environment) overrides this, whole: the
# command line cannot supply one half and leave the other to this file. Bracket
# an IPv6 literal, as in "[::1]:52380". A container publishing this port wants
# "0.0.0.0:52380".
#listen = "127.0.0.1:52380"

# The other form is a Unix socket, for a gateway that answers a reverse proxy on
# this machine and nothing else. Everything after "unix:" is the path, so a file
# name is never parsed for a port:
#
#listen = "unix:/run/remotex/gateway.sock"
#
# The socket is created 0660 — owner and group, so the proxy's user reaches it by
# sharing the group and no other local account reaches it at all, which is the
# only reason to prefer one to a loopback port. Arrange the directory to match.
# A socket left behind by a gateway that was killed is taken over on the next
# start; one that something is still serving refuses the start instead.
#
# A browser cannot use this form. The client addresses its gateway by URL — one
# HTTP origin and two WebSockets — so whatever terminates the proxy is what it
# talks to.
# Directory of the built frontend. Defaults to share/remotex/web in the active
# version (or frontend/dist in a checkout). Only set to override.
#static_dir = ""
# Web login (required): username:bcrypt_hash guarding the whole surface.
# Generate with:  remotex gen-passwd <username>
site_passwd = ""

# DEVELOPMENT ONLY, and inert in any deployment. Gives this gateway its own
# hostname on loopback: a browser opening the home page under *any* loopback name
# that is not this one — 127.0.0.1, ::1, anything in 127/8, localhost, or another
# gateway's <other>.localhost — is redirected to http://<label>.localhost:<port>/,
# keeping the port. The port decides which gateway answers, and that gateway names
# itself, so http://127.0.0.1:52676/ lands on the label configured *here*.
#
# Redirecting a mismatched .localhost name matters as much as redirecting a bare
# address: reaching this gateway at another one's hostname would put this session's
# cookie under that name, which is the collision below, arrived at by editing the
# port in the URL bar and not the label.
#
# Only the home page is redirected, and only when the request itself arrived on a
# loopback name — a gateway reached under a real hostname or address ignores this
# however it is set.
#
# It solves one problem: a cookie is scoped by host and ignores the port, so two
# gateways on one machine share one session cookie and each login silently evicts
# the other. Every label under .localhost resolves to loopback without DNS
# (RFC 6761) and is a distinct cookie origin, so two gateways become two
# independent logins in one browser. Running two gateways against one target is
# the only way to test session takeover, which is why this exists at all.
#
# One DNS label: letters, digits and inner hyphens, no dots.
#dev_subdomain = "gw-a"

# Target profiles (at least one required). Each needs a unique name. Every
# profile is served; the browser picks one from a picker after login (there is
# no --target selector).
[[targets]]
name = "example"
protocol = "rdp"           # required: "rdp" or "vnc"
# Which flavour of that protocol the far end is, where a protocol has more than
# one. Only "vnc" has any, and both are macOS Screen Sharing: "ard" and
# "ard-high-performance" (see the two Mac targets below). The latter is
# EXPERIMENTAL — prefer "ard" where it will do.
#subtype = "ard"
host = "192.0.2.10"
# Default: the protocol's standard port (3389 rdp, 5900 vnc).
#port = 3389

# Credentials (used server-side only; never sent to the browser).
username = "Administrator"
password = "change-me"
# A VNC server's own password (RFB VncAuth) — a separate key because it is a
# separate credential: it proves knowledge of a machine secret and names nobody.
# VNC only, rejected elsewhere. See the VNC target below.
#vnc_password = "change-me"
# Optional domain (leave unset for a local account). RDP only.
#domain = ""

# Optional pinned opening size. Set both keys or neither.
#
# RDP connects at the pinned size, and `subtype = "ard-high-performance"` creates
# its virtual display at it. With neither key, both instead open at the full
# resolution of the connecting client's own screen, falling back to 1280×800 only
# when the client supplies no screen. A generic VNC server and `subtype = "ard"`
# keep the remote's own size; for them these keys only answer a later default-size
# request, which still requires `resize = true` before it can be applied.
#
# These are points, not backing pixels. RDP opens at 1x and, with `resize`, a
# Retina client then asks for twice the pixels. High Performance opens at the
# connecting client's density even when its point size is pinned.
#width = 1280
#height = 800

# Security mode: "auto" (TLS+NLA, default), "nla" (NLA only), "tls" (no NLA).
# RDP only — VNC negotiates VncAuth (password set) or None per the handshake.
#security = "auto"

# Dynamic resize (opt-in): hand the remote desktop's size to the client's window.
# The client reports every window change while connected. There is no client-side
# resize toggle, one-shot "Resize to window" button or remembered preference: this
# one target setting is the policy.
#
# One narrowing that is not the client's to make either: generic VNC needs a
# server that accepts SetDesktopSize — the TigerVNC family — and Standard Apple
# `ard` refuses resize outright because it shares physical displays. Apple
# `ard-high-performance` uses Apple's dynamic-resolution feature to replace its
# one virtual display's configuration with arbitrary viewport sizes within its
# fixed 3840×2160 backing ceiling.
#
# Without it — and by default — the desktop keeps its opening size, and resize
# messages are ignored.
#resize = false

# RDP graphics pipeline, on by default and independent of `resize`. With both on,
# each resize is an EGFX graphics reset: no reactivation or reconnect, so it is
# cheap enough for the window to drive continuously. The trade is that a Windows
# host's text stays soft after the resize. Set this false for the sharp legacy
# path, whose reactivation re-renders the desktop at each size; a Windows session
# carrying sound on dynamic rdpsnd then reconnects so audio survives. RDP only,
# and refused on VNC even when set to false.
#egfx = true

# Clipboard bridge (opt-in): shares this target's clipboard with the browser.
# Copying on the remote pushes the text out, and your local clipboard is sent
# back whenever the tab regains focus — where the browser permits it, which
# needs HTTPS or localhost, since a plain-HTTP page has no clipboard access at
# all. The Clipboard panel always works regardless, and is the way to move text
# when automatic sync cannot run.
# RDP (MS-RDPECLIP) always carries full Unicode text. VNC does too on servers
# implementing the Extended Clipboard extension (TigerVNC does); on servers that
# do not (TightVNC), RFB falls back to latin-1 and anything outside it becomes "?".
# Both Apple subtypes use the Mac's native UTF-8 pasteboard protocol; High
# Performance carries its fetches and data inside the encrypted record transport.
#clipboard = false

# Remote audio: redirect this target's sound when the client asks for it, with the
# floating menu's Audio button. RDP only — MS-RDPEA is the one audio channel the
# gateway speaks and RFB has no equivalent, so it is refused on "vnc" rather than
# ignored there.
#
# The channel has to be negotiated when the connection is made, so an audio
# target asks the server to redirect from the moment it connects and throws the
# sound away while nobody is listening. Only 44100 Hz 16-bit stereo PCM is
# accepted; a server that offers no matching format sends nothing, and the log
# says so.
#
# One thing worth knowing before switching this on, and it is the browser's alone:
# it decodes Opus with WebCodecs, which is **secure-context only** — so a gateway
# reached over plain HTTP on a LAN address has no audio until it is behind TLS
# (localhost is exempt). `audio_codec = "pcm"` below is the exception and needs no
# decoder at all.
#audio = false

# How that audio is carried. Valid only with `audio = true` above; setting it
# without audio is refused rather than ignored.
#
#   "opus" (the default) — 96 kbps, 20 ms packets. Well clear of where stereo Opus
#     starts to be audibly lossy. Right for anything that leaves the building, and
#     the one to leave alone unless the link is a fast local network.
#   "pcm" — the remote's own samples, unencoded and unresampled, at 1.41 Mbit/s.
#     Fifteen times the bandwidth, and in exchange nothing between the remote's
#     mixer and the browser's output touches a sample: no encoder here, no decoder
#     there. It is also the only option that plays without WebCodecs, so it is the
#     one that works over plain HTTP to a LAN address.
#
# "pcm" is not the better-sounding option in any way you are likely to hear; it is
# the simpler path. Reach for it on a fast LAN, or where the secure-context rule
# above is in the way. Guacamole carries desktop audio this way and only this way,
# which is where it came from.
#audio_codec = "opus"

# Opus bitrate in kbit/s, 6–510. The default is 96. Valid only for Opus audio;
# PCM has no encoder to tune.
#audio_bitrate = 96

# Let Opus adapt to the audio socket's own backpressure. The configured bitrate
# stays the ceiling: sustained slow sends walk it down, sustained clear sends
# walk it back up, and silence is shed while the link is behind so old sound does
# not accumulate. Off by default, and valid only for Opus audio.
#audio_adaptive = false

# Floor for that adaptive walk in kbit/s, default 32. Valid only with
# `audio_adaptive = true`; an explicit floor must be 6–510 and below the bitrate
# ceiling.
#audio_bitrate_min = 32

# A VNC target needs host and, usually, one of the two passwords; domain and
# security are ignored, and width/height only ever answer a default-size request
# (see above). `vnc_password` is the server's own password and is all a server
# without user accounts takes.
# [[targets]]
# name = "workstation-vnc"
# protocol = "vnc"
# host = "10.0.0.2"
# vnc_password = "change-me"

# A Mac uses its built-in Screen Sharing service through this same path, with no
# companion software — say so with a subtype, and give it an *account* rather than
# the Screen Sharing password. Apple's DH authentication is the only way to tell a
# Mac who is connecting, and macOS answers a viewer that names nobody by creating a
# new login window on a virtual display instead of sharing its screen. So both
# subtypes require username and password (that account's) and take no
# vnc_password. Resize is where they part: `ard` is refused outright — a config
# setting it does not load — because it shares the Mac's physical displays, while
# `ard-high-performance` takes it for the one virtual display it makes, as the
# second example below does. A third-party VNC server that happens to run on a
# Mac is not this: it is a plain "vnc" target.
#
# `subtype = "ard"` is standard screen sharing on the ordinary RFB wire: the Mac's
# physical display list and native pasteboard, with one framebuffer holding every
# attached display at once. The first encoding list must remain zlib-free so the
# display layout arrives; a second list then switches the pixels from raw to zlib.
# [[targets]]
# name = "mac-screen-sharing"
# protocol = "vnc"
# subtype = "ard"
# host = "10.0.0.3"
# username = "andrew"
# password = "the-account-password"

# EXPERIMENTAL. Alone among the subtypes, nothing this one speaks is documented
# by Apple: the protocol revision, its record layer, its control messages and its
# virtual display handling were all reverse engineered, and are only as correct as
# the Macs they have been measured against. A macOS update is free to change any
# of it. The dynamic-resolution descriptor has been measured across arbitrary
# sizes and a burst of viewport reports but remains reverse engineered. Prefer
# "ard" unless you need a virtual display.
#
# `subtype = "ard-high-performance"` requests one virtual display instead of the
# Mac's physical displays. It opens at the pinned `width` and `height` when both
# are set, or at the full resolution of the client's screen otherwise, at that
# screen's density. Once connected, the Mac's physical displays are disabled and
# all of its windows are placed on this virtual display. The same zlib rectangles
# are carried over Apple's encrypted protocol revision. Apple's official macOS
# Screen Sharing client can choose up to two virtual displays; remotex requests
# one. With `resize = true`, viewport reports continuously replace the virtual
# display's mode as the window changes. Apple's display-count and fixed-resolution-
# preset controls are not implemented.
#
# It is also the one target that cannot use `render_type = "motion"`, in any of
# its forms — see the render dial below.
#
# `clipboard = true` enables the native Apple pasteboard in both directions.
# See docs/apple-vnc-889.md.
# [[targets]]
# name = "mac-virtual-display"
# protocol = "vnc"
# subtype = "ard-high-performance"
# host = "10.0.0.3"
# username = "andrew"
# password = "the-account-password"
# width = 1600
# height = 1000
# clipboard = true
# resize = true

# How this target's pixels are compressed on their way to the browser. A strategy,
# a still-image codec, and a quality dial, all per target and valid for every protocol.
#
# All three are per-target keys, so they belong *inside* a [[targets]] table and not
# in a section of their own — uncommented here they would attach to whichever
# [[targets]] block precedes them, which is the "example" one at the top of this file.
# There is no global render setting.
#
# render_type = "full" (the default) is lossless PNG: exact pixels, and the right
# answer on a LAN. "fixed-quality" trades exactness for bytes at a constant quality,
# which is what a slow or metered link wants. "motion" and "video" are described in
# their own blocks below.
#
# render_subtype picks the codec: "jpeg" is decoded by everything, "webp" is roughly
# 30% smaller at a matched quality and is decoded natively by the browser. With
# "full" the subtype must be "png". Under "motion" it is the *base* codec — see the
# block below, where it also decides which of the motion keys are required.
#
# render_quality is 1-100 and is *required* whenever the subtype is lossy, refused
# when it is "png" — there is no default, because a quality nobody chose is not a
# quality. Higher is larger and closer to exact.
#
# The defaults, spelled out. Nothing to add: PNG is lossless, so a quality here is
# refused rather than ignored.
#render_type = "full"
#render_subtype = "png"
#
# A fixed lossy encode instead — every tile at one quality, for a link that cannot
# afford exact pixels. A separate configuration from the two lines above, not more
# of them:
#render_type = "fixed-quality"
#render_subtype = "webp"
#render_quality = 75

# render_type = "motion" adds a second, cheaper encode used only for the cells that
# are currently changing fast, re-sending each one at the base encode once it
# settles. render_motion_subtype and render_motion_quality are that encode; the base
# keys above are what a still cell keeps. The motion quality can be very low —
# motion hides it, and it does not last.
#
# "motion" does not replace the base keys, it builds on them, so a base that is not
# PNG is spelled the ordinary way — with render_subtype and render_quality. Which of
# them are required follows from whether that base is lossless:
#
#   render_subtype = "png"  — render_quality refused (nothing to turn down), and
#                             render_motion_subtype required, since PNG cannot name
#                             the motion codec for it.
#   "jpeg" or "webp"        — render_quality required, and render_motion_subtype
#                             optional: omitted, the motion cells use the same codec
#                             as the base at render_motion_quality.
#
# A lossless base with lossy motion — everything settled is exact:
#render_type = "motion"
#render_motion_subtype = "jpeg"
#render_motion_quality = 10
#
# A lossy base with cheaper motion, for a link that cannot afford PNG at all. One
# codec, two qualities, so render_motion_subtype is left out:
#render_type = "motion"
#render_subtype = "webp"
#render_quality = 60
#render_motion_quality = 10

# One pairing "motion" is refused with, in every form it takes including "stream"
# below: subtype = "ard-high-performance". A resize under both corrupts the desktop
# until the whole gateway is restarted — a reconnect does not clear it — and which
# of the two is at fault is not established, so the config is refused at load
# rather than left to be discovered on a live desktop. Use subtype = "ard" to keep
# "motion", or any other render_type to keep the virtual display. Every other
# subtype may use "motion", and that target may use every other render_type.

# render_motion_subtype = "stream" is the third thing the motion axis can be, and
# the only one that is not a still: the cells in motion are coalesced into regions
# and each region gets its own video stream, while the base codec carries everything
# else. A video in a window costs its own pixels; the text beside it stays exactly
# what render_subtype says, and is never re-encoded at all.
#
# It is never a default — "jpeg" and "webp" fall back to the base codec, this one has
# to be written out — because it is not a cheaper version of the base but a different
# transport beside it. render_motion_quality is its dial, and there it is a *ceiling*:
# on a link that can carry it you get that quality, and a link that cannot makes the
# picture coarser until it can. Nothing goes finer than what is set here.
#
# A region that stops moving ends its stream and is re-sent once at the base encode,
# so a paused video sharpens by itself — the same promise the still motion encodes
# make, from the same cleanup pass.
#
# The secure-context note under "video" below applies here too: the access units are
# decoded with WebCodecs either way. The difference is what a browser that cannot
# decode them is left with — a desktop with a blank rectangle where the video is,
# rather than no desktop at all.
#render_type = "motion"
#render_motion_subtype = "stream"
#render_motion_quality = 30

# render_type = "video" is not a fourth codec, it is a different transport: the whole
# desktop as one video stream instead of one encoded image per changed region. Every
# frame says what changed since the one before it, so nothing is cut into per-region
# tiles and the cell grid does not apply — which is why it takes no render_subtype and
# refuses one. (The frames still travel in the same records the still codecs use, each
# carrying the desktop rectangle a client crops to; what goes away is the segmentation,
# not the framing.)
#
# render_quality is the dial, 1-100 as everywhere else, and it is a *ceiling*: on a
# link that can carry it you get exactly that quality, and a link that cannot makes
# the picture coarser until it can. Nothing ever goes finer than what is set here.
#
# One thing to know before choosing it:
#
#   - It is decoded with WebCodecs, which is **secure-context only** — the same limit
#     remote audio already has. A browser pointed at a gateway on a plain-HTTP LAN
#     address shows a banner saying so instead of a desktop, until it is behind TLS
#     (localhost is exempt).
#
# Worth measuring rather than assuming: it is a large win on anything that moves and
# it costs CPU on the gateway for every frame, including on a screen that is barely
# changing. The `encode totals` log line is what settles it for a given target.
#render_type = "video"
#render_quality = 60

# Let every lossy quality in this target's render plan track measured client
# queueing. The configured qualities remain ceilings. JPEG/WebP tiles lower their
# quality per encode; video streams add the client's paint lag to their existing
# send-pressure signal. Refused with `render_type = "full"`, which has no lossy
# dial to move.
#render_adaptive = false

# Floor for that adaptive walk, 1–100 and defaulting to 20. Valid only with
# `render_adaptive = true`, and it may not exceed any configured render quality.
#render_adaptive_min = 20

# QA aid for "motion", off unless asked for: outline every piece the strategy emits
# in the pixels themselves, so which cells it put in motion is something you read
# off the screen rather than infer from how blurry a region looks.
#
#   magenta — sent at the motion encode. Under render_motion_subtype = "stream" it is
#             the outline of a streamed region, drawn on the picture the encoder
#             sees rather than on the pixels a cleanup restores. Magenta over
#             something that is not moving is the detection reaching further than
#             the movement.
#   cyan    — sent at the base encode from inside a split region: a quiet cell
#             beside a moving one, and so the edge of the split.
#   green   — a cleanup: a settled cell restored to the base encode.
#
# An unmarked region was sent whole at the base encode, which is the quiet path and
# most of a still screen. So a blurry region with no outline on it is not a live
# decision at all — it is a stale one that nothing has replaced.
#render_motion_debug = false
