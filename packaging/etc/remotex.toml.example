# remotex configuration example
#
# The binary loads this file on startup (see src/config.rs). The config is
# global-only: --config <path> if given, else the installed
# <prefix>/etc/remotex.toml — no per-user or working-directory files. There are
# no environment variables — everything is configured here. Keep this file
# readable only by the service user — it holds credentials.
#
#   chmod 600 remotex.toml

[server]
# Listen address/port for the web UI (both optional; defaults shown).
#host = "127.0.0.1"
#port = 52380
# Directory of the built frontend. Defaults to share/remotex/web in the active
# version (or frontend/dist in a checkout). Only set to override.
#static_dir = ""
# Web login (required): username:bcrypt_hash guarding the whole surface.
# Generate with:  remotex gen-passwd <username>
site_passwd = ""
# Display name shown on the login screen, the interstitials, and as the browser
# tab title. Defaults to "remotex".
#branding = "remotex"

# Target profiles (at least one required). Each needs a unique name. Every
# profile is served; the browser picks one from a picker after login (there is
# no --target selector).
[[targets]]
name = "example"
protocol = "rdp"           # required: "rdp", "vnc" or "rxa"
host = "192.0.2.10"
# Default: the protocol's standard port (3389 rdp, 5900 vnc, 52381 rxa).
#port = 3389

# Credentials (used server-side only; never sent to the browser).
username = "Administrator"
password = "change-me"
# Optional domain (leave unset for a local account). RDP only.
#domain = ""

# Initial desktop size to request. RDP only — a VNC server dictates its size.
#width = 1280
#height = 800

# Security mode: "auto" (TLS+NLA, default), "nla" (NLA only), "tls" (no NLA).
# RDP only — VNC negotiates VncAuth (password set) or None per the handshake.
#security = "auto"

# Dynamic resize (opt-in): drive the remote desktop size from the browser
# viewport. VNC follows the window automatically (only on servers that accept
# SetDesktopSize — the TigerVNC family). RDP resizes only when you ask, via the
# floating menu's "Resize to window" (RDP reactivation is heavier than VNC's
# resize). Otherwise — and by default — the desktop keeps its connect-time size
# and the browser shows scrollbars.
#resize = false

# Clipboard bridge (opt-in): lets the floating menu's Clipboard panel read and
# write this target's clipboard. Nothing is synced in the background — the
# browser only fetches or sends when you press the button, and keeps no copy.
# VNC carries latin-1 text (the RFB cut-text messages); the Mac agent ("rxa")
# reads its pasteboard on request and carries full UTF-8. Rejected for RDP,
# which has no clipboard channel yet.
#clipboard = false

# A VNC target only needs host and (usually) a password; username, domain,
# width/height, and security are ignored. A Mac can use its built-in Screen
# Sharing service through this path without installing the companion agent.
# [[targets]]
# name = "mac-screen-sharing"
# protocol = "vnc"
# host = "10.0.0.2"
# password = "change-me"

# As an optional alternative, a Mac can run the remotex agent (protocol "rxa")
# for RealVNC-like reconnect behavior. The pre-shared key below is the
# connection credential, so reconnects authenticate directly instead of
# returning to Screen Sharing's login gate. The Noise handshake authenticates
# both ends from it.
#
# The same key goes in two places, and they must match exactly:
#   1. `psk` here, and
#   2. `psk` in the Mac's ~/Library/Application Support/remotex-agent/config.toml
# Generate one with:  remotex gen-psk
#
# The agent runs in the Mac user's login session and needs two one-time grants
# in System Settings -> Privacy & Security: Screen Recording and Accessibility.
# It cannot run at the login window, so nobody logged in means nothing to reach.
#
# username/password/domain/width/height/security are all ignored here, and
# `resize` is rejected — the agent captures the Mac's own resolution.
# `clipboard` is supported: the agent reads and writes the Mac's pasteboard.
# [[targets]]
# name = "mac"
# protocol = "rxa"
# host = "mac.local"
# psk = "rxa..."
