# remotex configuration example
#
# The binary loads this file on startup (see src/config.rs). The config is
# global-only: --config <path> if given, else the installed
# <prefix>/etc/remotex.toml — no per-user or working-directory files. There are
# no environment variables — everything is configured here. Keep this file
# readable only by the service user — it holds credentials.
#
#   chmod 600 remotex.toml

[server]
# Listen address/port for the web UI (both optional; defaults shown).
#host = "127.0.0.1"
#port = 52380
# Directory of the built frontend. Defaults to share/remotex/web in the active
# version (or frontend/dist in a checkout). Only set to override.
#static_dir = ""
# Web login (required): username:bcrypt_hash guarding the whole surface.
# Generate with:  remotex gen-passwd <username>
site_passwd = ""
# Display name shown on the login screen, the interstitials, and as the browser
# tab title. Defaults to "remotex".
#branding = "remotex"

# This gateway's identity on the "rxa" protocol — the macOS agent (see the rxa
# target near the end of this file). Required as soon as any target is
# protocol = "rxa", and unused otherwise.
#
# One key for the whole server, not one per Mac: this is the [Interface] half of
# a WireGuard-style pairing, and every agent is configured with its public half.
# Generate with:      remotex gen-key
# Read the public half with:   remotex rxa-pubkey
#[rxa]
#private_key = "rxgs..."

# Target profiles (at least one required). Each needs a unique name. Every
# profile is served; the browser picks one from a picker after login (there is
# no --target selector).
[[targets]]
name = "example"
protocol = "rdp"           # required: "rdp", "vnc" or "rxa"
# Which flavour of that protocol the far end is, where a protocol has more than
# one. Only "vnc" has any: subtype = "ard" is macOS Screen Sharing (see below).
#subtype = "ard"
host = "192.0.2.10"
# Default: the protocol's standard port (3389 rdp, 5900 vnc, 52381 rxa).
#port = 3389

# Credentials (used server-side only; never sent to the browser).
username = "Administrator"
password = "change-me"
# A VNC server's own password (RFB VncAuth) — a separate key because it is a
# separate credential: it proves knowledge of a machine secret and names nobody.
# VNC only, rejected elsewhere. See the VNC target below.
#vnc_password = "change-me"
# Optional domain (leave unset for a local account). RDP only.
#domain = ""

# Initial desktop size to request. RDP only — a VNC server dictates its size.
#width = 1280
#height = 800

# Security mode: "auto" (TLS+NLA, default), "nla" (NLA only), "tls" (no NLA).
# RDP only — VNC negotiates VncAuth (password set) or None per the handshake.
#security = "auto"

# Dynamic resize (opt-in): drive the remote desktop size from the client's
# window. VNC follows the window automatically (only on servers that accept
# SetDesktopSize — the TigerVNC family). RDP resizes only when you ask, via
# "Resize to window" (RDP reactivation is heavier than VNC's resize). rxa is on
# request too, and narrower: see the rxa section below.
# Otherwise — and by default — the desktop keeps its connect-time size
# and the client shows scrollbars.
#resize = false

# Clipboard bridge (opt-in): shares this target's clipboard with the browser.
# Copying on the remote pushes the text out, and your local clipboard is sent
# back whenever the tab regains focus — where the browser permits it, which
# needs HTTPS or localhost, since a plain-HTTP page has no clipboard access at
# all. (The macOS viewer has no such restriction: it reads NSPasteboard
# directly.) The Clipboard panel always works regardless, and is the way to move
# text when automatic sync cannot run.
# Every protocol supports it. RDP (MS-RDPECLIP) and the Mac agent ("rxa")
# always carry full UTF-8. VNC does too on servers implementing the Extended
# Clipboard extension (TigerVNC does); on servers that do not (TightVNC), RFB
# falls back to latin-1 and anything outside it becomes "?".
#clipboard = false

# A VNC target needs host and, usually, one of the two passwords; domain,
# width/height, and security are ignored. `vnc_password` is the server's own
# password and is all a server without user accounts takes.
# [[targets]]
# name = "workstation-vnc"
# protocol = "vnc"
# host = "10.0.0.2"
# vnc_password = "change-me"

# A Mac can use its built-in Screen Sharing service through this same path,
# without installing the companion agent — say so with subtype = "ard", and give
# it an *account* rather than the Screen Sharing password. Apple's DH
# authentication is the only way to tell a Mac who is connecting, and macOS
# answers a viewer that names nobody by creating a new login window on a virtual
# display instead of sharing its screen. So the subtype requires username and
# password (that account's), takes no vnc_password, and rejects resize, which
# macOS accepts and then ignores. A third-party VNC server that happens to run
# on a Mac is not this: it is a plain "vnc" target.
# [[targets]]
# name = "mac-screen-sharing"
# protocol = "vnc"
# subtype = "ard"
# host = "10.0.0.3"
# username = "andrew"
# password = "the-account-password"

# As an optional alternative, a Mac can run the remotex agent (protocol "rxa")
# for RealVNC-like reconnect behavior. Reconnects authenticate from a keypair on
# each end instead of returning to Screen Sharing's login gate.
#
# Pairing is two public keys, one each way — the way WireGuard pairs an interface
# with a peer. Neither is a secret; the private key behind each stays on the
# machine that made it:
#
#   1. This gateway's identity is [rxa].private_key, above. Its public half —
#      printed by `remotex rxa-pubkey` — goes in `gateway_public_key` in the
#      Mac's ~/Library/Application Support/remotex-agent/config.toml, or in the
#      agent's Settings dialog.
#   2. The Mac's public key goes in `agent_public_key` below. Its Settings dialog
#      shows it with a Copy button, and `remotex-agent --public-key` prints it.
#
# One [rxa].private_key serves every rxa target: it is this server's identity,
# not a per-Mac credential. Each Mac keeps its own key across re-pairings, so
# pointing one at a different gateway is a one-field edit on the Mac rather than
# new key material on both ends.
#
# The agent runs in the Mac user's login session and needs two one-time grants
# in System Settings -> Privacy & Security: Screen Recording and Accessibility.
# It cannot run at the login window, so nobody logged in means nothing to reach.
#
# username/password/domain/width/height/security are all ignored here.
# `clipboard` is supported: the agent reads and writes the Mac's pasteboard.
#
# `resize` is supported, for one display only. A Mac's own screens are set on the
# Mac, in System Settings, and nothing here asks a physical panel to change; the
# agent notices whatever mode it is put in and the client follows. But the agent
# can also create a private display for itself (`virtual_display` in its own
# config), and nobody is sitting at that one — so with `resize = true` here,
# "Resize to window" asks it to match the window it is being viewed in. It
# applies only while that display is the one being shared: the viewer keeps the
# menu item and greys it out otherwise, the browser shows its button only when it
# applies. On a Mac whose agent has no such display it never applies at all.
# [[targets]]
# name = "mac"
# protocol = "rxa"
# host = "mac.local"
# agent_public_key = "rxap..."
