<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>dev.remotex.viewer</string>
	<!-- The bundle is remotex.app and the product is remotex; the identifier stays
	     dev.remotex.viewer, because TCC grants and saved window state are keyed on it
	     and a rename must not quietly reset them. The executable keeps its own name
	     too: the gateway binary lives beside it in Contents/MacOS. -->
	<key>CFBundleName</key>
	<string>remotex</string>
	<key>CFBundleDisplayName</key>
	<string>remotex</string>
	<key>CFBundleExecutable</key>
	<string>remotex-viewer</string>
	<!-- Chromium will not run under a plain NSApplication: it asks the running app
	     whether it is inside -sendEvent:, which only NSApp itself can answer. The
	     subclass is named here rather than installed at startup because
	     NSApplication.shared reads this key, and by then the instance exists. The
	     module prefix is the Swift target's, which is how the Objective-C runtime
	     spells a Swift class. -->
	<key>NSPrincipalClass</key>
	<string>RemotexViewer.ViewerApplication</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleVersion</key>
	<string>0.0.0</string>
	<key>CFBundleShortVersionString</key>
	<string>0.0.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- The gateway this app talks to is its own, on plain HTTP over loopback, and
	     ATS treats ws:// as http:// so the session socket needs the same exception.
	     Deliberately not scoped to 127.0.0.1 with NSExceptionDomains: ATS exempts
	     loopback from most of its rules but not from every future one, and the whole
	     conversation here never leaves the machine. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
