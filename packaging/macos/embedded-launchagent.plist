<?xml version="1.0" encoding="UTF-8"?>
<!--
  Embedded LaunchAgent plist. Copied verbatim into
  remotex-agent.app/Contents/Library/LaunchAgents/dev.remotex.agent.plist by
  build-agent-app.sh, and handed to launchd by SMAppService when the agent
  registers itself (see crates/rxa-agent/src/loginitem.rs).

  Nothing installs a copy of this into ~/Library/LaunchAgents. That is the point:
  the bundle is self-contained, it shows up in System Settings > General > Login
  Items, and uninstalling is moving it to the Trash.

  `Label` must match `loginitem::LABEL` and this file's installed name, or
  registration finds nothing.

  `BundleProgram` is a path *relative to the app bundle* — an SMAppService
  extension to launchd's schema. It is what lets the user move the app after
  registering without breaking it; an absolute `Program` would not survive that.

	The capture process belongs in a LaunchAgent, not a LaunchDaemon: both TCC
	grants require a GUI session with a window server. This embedded agent is
	registered per user through SMAppService and runs only in that user's Aqua
	session. Login-window support would instead require privileged installation
	of a system-wide LaunchAgent targeting both LoginWindow and Aqua; see
	docs/roadmap.md.

  ProcessType Interactive keeps the agent off the throttled background tier, so
  macOS does not slow its capture and encode work down.

  No StandardOutPath/StandardErrorPath: launchd does not expand `~`, and there is
  no absolute path that is correct for every user. The agent redirects its own
  logging to ~/Library/Logs/remotex-agent.log when it is not on a terminal.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.remotex.agent</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/remotex-agent</string>
	<key>RunAtLoad</key>
	<true/>
	<!-- No KeepAlive, deliberately: launchd starts this at login and on an
	     explicit `kickstart`, and never on its own. It used to carry
	     `KeepAlive { SuccessfulExit: false }` for crash recovery, and the cost of
	     that was stale instances: any death by signal counts as an unsuccessful
	     exit, so launchd relaunched within ~2 s from whatever was on disk at that
	     moment — mid-upgrade, that is the *old* bundle, running against the new
	     one's config and holding the port the new one wants. An agent that has
	     died stays dead now, which is visible (no menu bar icon, connections
	     refused) rather than quietly wrong, and the next login or `open` brings it
	     back. `restart` and `hand_over_to_launchd` are unaffected: both drive the
	     job explicitly. -->
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>RUST_LOG</key>
		<string>info</string>
	</dict>
</dict>
</plist>
